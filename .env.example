# ============================================================================
# শিক্ষামূলক Sandwich/Backrun MEV Bot — .env.example
# এই ফাইল কপি করে .env নামে রাখুন এবং নিজের ভ্যালু দিয়ে পূরণ করুন।
# .env ফাইলটা কখনো git-এ কমিট করবেন না (private key থাকে)।
# ============================================================================

# --- নেটওয়ার্ক ---
# "sepolia" অথবা "mainnet"। শুরুতে সবসময় sepolia দিয়ে টেস্ট করুন।
# NOTE: mainnet-এ live execution এই কোডে ইচ্ছাকৃতভাবে বন্ধ (README দেখুন) —
# mainnet সবসময় WATCH MODE-এ চলবে, TRADING_MODE=live দিলেও।
NETWORK=sepolia

# Alchemy/Infura WebSocket RPC URL। mempool দেখার জন্য WSS দরকার, HTTPS না।
# উদাহরণ (Sepolia): wss://eth-sepolia.g.alchemy.com/v2/আপনার-api-key
# উদাহরণ (mainnet): wss://eth-mainnet.g.alchemy.com/v2/আপনার-api-key
RPC_WSS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# --- টার্গেট DEX Router ---
# যে Uniswap V2-স্টাইল router মনিটর করা হবে (উদাহরণ: Uniswap V2 Router02)
# Sepolia টেস্ট করার জন্য নিজে একটা test router deploy করতে পারেন অথবা
# পাবলিক testnet DEX router address ব্যবহার করুন।
TARGET_CONTRACT=0x0000000000000000000000000000000000000000

# --- Wallet (শুধু LIVE MODE-এ দরকার) ---
# bot যে wallet দিয়ে front/back tx sign করে পাঠাবে। এখানে টেস্ট wallet-এর
# private key দিন, কখনো আপনার main wallet-এর key এখানে দেবেন না।
PRIVATE_KEY=

# ============================================================================
# TRADING MODE — সেফটি সিস্টেম
# ============================================================================

# "watch" (ডিফল্ট, নিরাপদ) অথবা "live" (আসল bundle পাঠাবে, শুধু Sepolia-তে)
TRADING_MODE=watch

# live mode চালু করতে এই এক্স্যাক্ট স্ট্রিং দরকার। ভুল/খালি থাকলে bot
# স্বয়ংক্রিয়ভাবে watch mode-এ ফিরে যাবে।
CONFIRM_LIVE_TRADING=

# LIVE MODE-এ front-tx-এর সাইজ (USD) এর বেশি হলে bundle স্বয়ংক্রিয়ভাবে স্কিপ
# হবে, net profit যতই ভালো হোক না কেন। ছোট রেখে শুরু করা উচিত।
MAX_TRADE_AMOUNT_USD=10

# ============================================================================
# PROFITABILITY CALCULATION
# ============================================================================

# net profit এর নিচে হলে bundle স্কিপ হবে (USD এককে)
MIN_PROFIT_USD=5

# DEX-এর প্রতি swap trading fee, শতকরা হিসেবে (Uniswap V2 ডিফল্ট 0.3%)
DEX_FEE_PERCENT=0.3

# Flashbots block builder-কে extra priority tip, gwei এককে
FLASHBOTS_TIP_GWEI=2

# bot-এর front-run tx, victim-এর tx-এর কত অনুপাতে হবে (1.0 = সমান সাইজ)
FRONT_RUN_SIZE_RATIO=1.0

# front/back tx-এর expected output-এর কত % slippage tolerance রাখা হবে
SANDWICH_SLIPPAGE_TOLERANCE_PERCENT=1.0

# --- Gas Limits ---
FRONT_TX_GAS_LIMIT=250000
BACK_TX_GAS_LIMIT=250000

# ============================================================================
# FLASHBOTS
# ============================================================================

# Flashbots relay RPC URL। mainnet: https://relay.flashbots.net
# sepolia: https://relay-sepolia.flashbots.net (নিজে npm প্যাকেজের ডকুমেন্টেশনে
# বর্তমান URL যাচাই করে নিন, এই ইকোসিস্টেম মাঝেমধ্যে বদলায়)
FLASHBOTS_RPC_URL=https://relay-sepolia.flashbots.net
